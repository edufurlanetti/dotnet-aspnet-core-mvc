@model Aluno
@{
    ViewData["Title"] = "Editar aluno";
}

<h1 class="h3 mb-3">Editar aluno</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm">
    <input type="hidden" asp-for="Id" />
    <partial name="_Formulario" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar alterações</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
