@model IEnumerable<Aluno>
@{
    ViewData["Title"] = "Alunos";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 m-0">Alunos</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Novo aluno</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-lg-5">
        <input type="search" name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Buscar por nome ou e-mail..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Buscar</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover bg-white shadow-sm">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(m => m.Nome)</th>
                <th>@Html.DisplayNameFor(m => m.Email)</th>
                <th>@Html.DisplayNameFor(m => m.Telefone)</th>
                <th class="text-center">Matrículas ativas</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var aluno in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@aluno.Id">@aluno.Nome</a></td>
                    <td>@aluno.Email</td>
                    <td>@(aluno.Telefone ?? "—")</td>
                    <td class="text-center">@(aluno.Matriculas.Count(m => m.Status == StatusMatricula.Ativa))</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@aluno.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
