@model string
@{
    ViewData["Title"] = "Erro";
}

<div class="text-center py-5">
    <i class="bi bi-bug display-3 text-danger"></i>
    <h1 class="h3 mt-3">Ocorreu um erro ao processar a sua solicitação</h1>
    <p class="text-muted">Código para suporte: <code>@Model</code></p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Voltar ao início</a>
</div>
