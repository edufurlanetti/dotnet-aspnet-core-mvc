@model Curso
@* Partial view reutilizada pelas telas de cadastro e edição *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Area" class="form-label"></label>
        <select asp-for="Area" asp-items="Html.GetEnumSelectList<AreaCurso>()" class="form-select"></select>
    </div>
    <div class="col-12">
        <label asp-for="Descricao" class="form-label"></label>
        <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descricao"></span>
    </div>
    <div class="col-sm-6 col-lg-3">
        <label asp-for="CargaHoraria" class="form-label"></label>
        <input asp-for="CargaHoraria" class="form-control" />
        <span asp-validation-for="CargaHoraria"></span>
    </div>
    <div class="col-sm-6 col-lg-3">
        <label asp-for="Vagas" class="form-label"></label>
        <input asp-for="Vagas" class="form-control" />
        <span asp-validation-for="Vagas"></span>
    </div>
    <div class="col-sm-6 col-lg-3">
        <label asp-for="Valor" class="form-label">Valor (R$)</label>
        <input asp-for="Valor" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="Valor"></span>
    </div>
    <div class="col-sm-6 col-lg-3">
        <label asp-for="DataInicio" class="form-label"></label>
        <input asp-for="DataInicio" class="form-control" />
        <span asp-validation-for="DataInicio"></span>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="Ativo" class="form-check-input" />
            <label asp-for="Ativo" class="form-check-label">Aceitando matrículas</label>
        </div>
    </div>
</div>
